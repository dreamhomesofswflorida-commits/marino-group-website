  "appName": "Marino Group",
  "webDir": "www",
  "backgroundColor": "#141312",
  "server": {
    "url": "https://marinogroupswfl.com/app/",
    "allowNavigation": ["marinogroupswfl.com", "*.marinogroupswfl.com", "matrix.swflamls.com"]
  },
  "ios": {
